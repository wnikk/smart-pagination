{
    "name": "wnikk/smart-pagination",
    "version": "2.1.1",
    "description": "Reverse pagination for Laravel with SEO-friendly links and stable URLs",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "pagination", "reverse pagination", "seo", "blade"],
    "authors": [
        {
            "name": "Nikolay May",
            "homepage": "https://nikk.dev",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/wnikk/smart-pagination",
    "bugs": {
        "url": "https://github.com/wnikk/smart-pagination/issues"
    },
    "autoload": {
        "psr-4": {
            "Wnikk\\SmartPagination\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wnikk\\SmartPagination\\SmartPaginationServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.4",
        "illuminate/database": "^13.0",
        "illuminate/pagination": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
